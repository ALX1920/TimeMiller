# Copia este archivo a ".env" y cambia los valores antes de desplegar.

# Clave secreta de Django. Genera una nueva con:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=changeme-genera-una-clave-larga-y-aleatoria

# En producción SIEMPRE en False
DJANGO_DEBUG=False

# Dominios/IPs desde los que se puede acceder al backend, separados por coma
DJANGO_ALLOWED_HOSTS=api.tu-dominio.dev,localhost,127.0.0.1

# Dominio EXACTO del frontend (GitHub Pages), sin slash final
CORS_ALLOWED_ORIGINS=https://timemiller.gargantua.interestelar.alejandromtz.dev

# Sal usada para anonimizar las IPs antes de guardarlas (no es reversible,
# pero cámbiala igual y no la compartas)
VISIT_SALT=changeme-otra-cadena-aleatoria

DJANGO_TIME_ZONE=America/Mexico_City
